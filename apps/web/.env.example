# Client API — must match the deployed apps/api URL
NUXT_PUBLIC_API_URL=http://localhost:4000

# ── Feature flags — must match FEATURE_* in apps/api/.env exactly ────────────
# Commerce: products, cart, checkout, orders, enquiries
NUXT_PUBLIC_FEATURE_COMMERCE=false

# Analytics: auto page_view + explicit event tracking
NUXT_PUBLIC_FEATURE_ANALYTICS=false

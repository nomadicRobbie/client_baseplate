{
  "name": "@blnk/client-api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify backend for a blnk client (baseplate)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@blnk/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.8.5",
    "fastify-plugin": "^4.5.1",
    "jose": "^5.9.4",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}

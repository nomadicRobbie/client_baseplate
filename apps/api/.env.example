# ── Core ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# This client's tenant (must match a tenant_auth_config slug in blnk_auth)
TENANT_SLUG=ting-test

# ── Per-client database (containerised) ───────────────────
# DB name/user/password all match TENANT_SLUG — docker-compose reads this file directly.
# PG_PORT: pick any free local port (5435 is the default; increment for each concurrent client).
# In production DATABASE_URL points at the shared blnk_postgres — no PG_PORT needed.
PG_PORT=5435
DATABASE_URL=postgres://ting-test:ting-test@localhost:5435/ting-test

# ── blnk platform ─────────────────────────────────────────
BLNK_AUTH_URL=http://localhost:3100      # auth proxy + JWKS verification
BLNK_API_URL=http://localhost:8000       # email / portal / billing
BLNK_API_KEY=                            # blnk_api ApiKey (email etc.) — blank OK in dev

# ── Frontend origins allowed to call this api (CORS) ──────
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Hot-swap feature modules ──────────────────────────────
FEATURE_STRIPE=false
FEATURE_ONE_OFF=false
FEATURE_SUBSCRIPTIONS=false
FEATURE_COMMERCE=false        # online store — products, orders, payment intents, enquiries
FEATURE_ANALYTICS=false       # event ingest (public) + dashboard query routes (admin)
FEATURE_COMPLIANCE=false      # food safety compliance records (registry + validation engine)
FEATURE_LOCATIONS=false       # public-site "next location" banner (food trucks / markets)
FEATURE_SCHEDULE=false        # service scheduling register (templates, instances, assignments)

# ── Client's OWN Stripe account (only needed when FEATURE_STRIPE=true) ─────
# Required in production when Stripe is enabled; blank is fine in dev/off.
STRIPE_API_KEY=                # client's restricted key (rk_...)
STRIPE_WEBHOOK_SECRET=         # from `stripe listen` / dashboard webhook
STRIPE_CURRENCY=nzd

# ── Cloudinary image uploads (commerce product images) ────────────────────
# Required in production when FEATURE_COMMERCE=true; blank is fine in dev/off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Native app association (apple-app-site-association / assetlinks.json) ──
APPLE_APP_IDS=                # comma-separated, e.g. TEAMID.nz.ting-test.app
ANDROID_PACKAGE=             # e.g. nz.tingtest.app
ANDROID_SHA256=              # comma-separated cert fingerprints

LOG_LEVEL=info
